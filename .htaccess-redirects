# =========================================================================
# AutomateX.ai PHP to WordPress 301 Redirect Rules
# Append these rules to your WordPress .htaccess file (above WordPress block)
# =========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Wildcard Redirect for the 72 City landing pages:
    # Redirects: domain.com/cities/agra.php -> domain.com/cities/agra/
    RewriteRule ^cities/([a-zA-Z0-9_-]+)\.php$ /cities/$1/ [R=301,L,NC]

    # 2. Main Page Redirect (if applicable):
    RewriteRule ^index\.php$ / [R=301,L,NC]

    # 3. Core & Industry Landing Pages:
    Redirect 301 /about-us.php /about-us/
    Redirect 301 /contact-us.php /contact-us/
    Redirect 301 /accounting.php /accounting/
    Redirect 301 /ai-business.php /ai-business/
